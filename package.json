{
  "name": "megahub",
  "productName": "MegaHUB",
  "version": "0.1.0",
  "description": "MegaHUB — todos tus juegos de todas las plataformas en un solo lugar, por DERIVA",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "lint": "eslint .",
    "lint:ci": "node scripts/lint-ci.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "7zip-min": "^3.0.1",
    "adm-zip": "^0.6.0",
    "node-unrar-js": "^2.0.2"
  },
  "build": {
    "appId": "app.deriva.megahub",
    "productName": "MegaHUB",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "ui/**",
      "package.json",
      "build/icon.ico",
      "docs/multiplayer/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "MegaHUB-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MegaHUB"
    },
    "asarUnpack": [
      "**/node_modules/7zip-bin/**/*"
    ]
  }
}
